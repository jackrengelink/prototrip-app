# Copy to .env and adjust. All settings are optional except ADMIN_PASSWORD in production.

# Password for the trip admin (you). If not set, one is generated on first start and printed in the log.
ADMIN_PASSWORD=change-me-to-something-long

# Public address of the app, used in calendar feeds and notifications (e.g. https://trip.example.org)
PUBLIC_URL=

# Storage: by default data is saved as files in DATA_DIR.
DATA_DIR=./data
# ...or set a PostgreSQL connection string to store everything in a database instead.
# DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=require

# Port to listen on
PORT=3000

# Load the example trip when the app starts for the very first time (handy for trying it out)
# SEED_DEMO=true
